{
  "name": "cyclereg",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype organizer workspace for U.S. road race and criterium registration (category builder milestone).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "seed:demo": "tsx src/server/seed-cli.ts",
    "seed:berkeley": "tsx src/server/seed-cli.ts --berkeley",
    "seed:omnium": "tsx src/server/seed-cli.ts --omnium",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.8",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
